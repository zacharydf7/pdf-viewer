@page "/"

<div class="sample">
    <aside class="sample-panel">
        <h1>PDF viewer sample</h1>

        <label>
            Open a local file
            <input type="file" accept="application/pdf" data-testid="file-input" @ref="_fileInput"
                   @onchange="OpenSelectedFile" />
        </label>

        <div>
            <button type="button" data-testid="tool-select"
                    @onclick="() => _controller.SetToolAsync(ViewerTool.Select)">
                Select
            </button>
            <button type="button" data-testid="tool-draw" @onclick="DrawHeading">Draw heading</button>
            <button type="button" data-testid="add-object" @onclick="AddObject">Add from code</button>
            <button type="button" data-testid="rotate-page" @onclick="RotateCurrentPage">Rotate page to 180</button>
            <button type="button" data-testid="read-bytes" @onclick="ReadDocumentBytes">Read document bytes</button>
            <button type="button" data-testid="go-to-page-3" @onclick="GoToThirdPage">Go to page 3</button>
            <button type="button" data-testid="border-hit-area" @onclick="UseBorderHitArea">Use border hit area</button>
        </div>

        @if (_pendingDialog is not null)
        {
            <div role="dialog" aria-label="Keep this region?" data-testid="confirm-dialog">
                <p>Keep this region?</p>
                <button type="button" data-testid="dialog-save" @onclick="() => _pendingDialog.SetResult(true)">
                    Save
                </button>
                <button type="button" data-testid="dialog-cancel" @onclick="() => _pendingDialog.SetResult(false)">
                    Cancel
                </button>
            </div>
        }

        <h2>Objects</h2>
        <ul data-testid="object-list">
            @foreach (var viewerObject in _objects)
            {
                <li data-listed-object="@viewerObject.Id">@viewerObject.Id on page @viewerObject.Page</li>
            }
        </ul>

        <h2>Status</h2>
        <dl>
            <dt>Last change</dt>
            <dd data-testid="last-change">@_lastChange</dd>
            <dt>Selected object</dt>
            <dd data-testid="selected-object">@_selectedObject</dd>
            <dt>Selected IDs</dt>
            <dd data-testid="selected-ids">@_selectedIds</dd>
            <dt>Last kind</dt>
            <dd data-testid="last-kind">@_lastKind</dd>
            <dt>Last error</dt>
            <dd data-testid="last-error">@_lastError</dd>
            <dt>Documents loaded</dt>
            <dd data-testid="load-count">@_loadCount</dd>
            <dt>Document bytes</dt>
            <dd data-testid="document-bytes">@_documentBytes</dd>
            <dt>Page shown after turning</dt>
            <dd data-testid="shown-page">@_shownPage</dd>
        </dl>
    </aside>

    <main class="sample-viewer">
        @* The headless query option shows the settings an application with its own controls would use. *@
        <PdfViewer Controller="_controller" Source="_source" InitialPage="Page ?? 1" ShowToolbar="!Headless"
                   Options="_options" Objects="_objects" OnDocumentLoaded="() => _loadCount++"
                   OnObjectsChanged="HandleObjectsChanged" OnSelectionChanged="HandleSelectionChanged"
                   OnError="error => _lastError = error.Code.ToString()" />
    </main>
</div>

@code {
    private readonly PdfViewerController _controller = new();
    private PdfViewerOptions _options = new();
    private ElementReference _fileInput;
    private PdfSource? _source;
    private TaskCompletionSource<bool>? _pendingDialog;
    /// <summary>
    /// The objects on display. The viewer shows this list, and the user's changes are written back to it.
    /// </summary>
    private readonly List<ViewerObject> _objects = [];
    private string _lastChange = "";
    private string _lastKind = "";
    private string _selectedObject = "none";
    private string _selectedIds = "";
    private string _lastError = "";
    private int _loadCount;
    private long _documentBytes;
    private string _shownPage = "";
    private int _nextObject = 1;

    [SupplyParameterFromQuery] public string? Doc { get; set; }

    [SupplyParameterFromQuery] public int? Page { get; set; }

    [SupplyParameterFromQuery] public bool Headless { get; set; }

    /// <summary>
    /// Shows a dialog after each drawing and waits for it inside the change handler, then keeps or removes the object.
    /// </summary>
    [SupplyParameterFromQuery] public bool ConfirmDraw { get; set; }

    /// <summary>
    /// Picks the draw tool and turns to page 3 before the viewer has attached. The controller holds the commands until
    /// it does, and the page turn applies to the document as it opens.
    /// </summary>
    [SupplyParameterFromQuery] public bool EarlyCommands { get; set; }

    protected override void OnInitialized()
    {
        if (EarlyCommands)
        {
            _ = DrawHeading();
            _ = _controller.GoToPageAsync(3);
        }
    }

    protected override void OnParametersSet()
    {
        _source = Doc is null ? null : PdfSource.FromUrl($"/{Doc}");
        _options = _options with
        {
            InitialZoom = Headless ? ViewerZoomMode.FitPage : ViewerZoomMode.FitWidth,
            HideFormFields = Headless,
            KeyboardEditing = !Headless,
            RoundCoordinates = Headless,
            Coordinates = Headless ? ViewerCoordinates.Display : ViewerCoordinates.Page,
            ObjectHitArea = Headless ? ViewerObjectHitArea.Border : ViewerObjectHitArea.Fill,
        };
    }

    /// <summary>The objects belong to the document they were drawn on, so a new document starts with none.</summary>
    private void OpenSelectedFile()
    {
        _objects.Clear();
        _source = PdfSource.FromFileInput(_fileInput);
    }

    private Task DrawHeading() => _controller.SetToolAsync(ViewerTool.DrawRectangle, new ViewerDrawDefaults
    {
        Kind = "heading",
        Label = "Heading region",
    });

    private void AddObject()
    {
        var id = $"code-{_nextObject++}";
        var rect = new PageRect(50, 50, 150, 80);
        var viewerObject = new ViewerObject(id, _controller.CurrentPage, rect) { Label = $"Region {id}" };
        _objects.Add(viewerObject);
        Record("Added", ChangeOrigin.Api, viewerObject);
    }

    private Task RotateCurrentPage() =>
        _controller.SetPageRotationAsync(_controller.CurrentPage, PageRotation.Rotate180);

    private async Task ReadDocumentBytes()
    {
        using var stream = new MemoryStream();
        await _controller.CopyDocumentToAsync(stream);
        _documentBytes = stream.Length;
    }

    /// <summary>Shows the page reached only once the turn has finished, which is when the page has rendered.</summary>
    private async Task GoToThirdPage()
    {
        _shownPage = "";
        await _controller.GoToPageAsync(3);
        _shownPage = _controller.CurrentPage.ToString();
    }

    private void UseBorderHitArea() => _options = _options with { ObjectHitArea = ViewerObjectHitArea.Border };

    private async Task HandleSelectionChanged(SelectionChangedArgs args)
    {
        _selectedObject = args.PrimaryId ?? "none";
        _selectedIds = string.Join(" ", await _controller.GetSelectedObjectIdsAsync());
    }

    /// <summary>Writes what the user did into the list, which is what keeps it from being undone.</summary>
    private async Task HandleObjectsChanged(ObjectsChangedArgs args)
    {
        foreach (var added in args.Added)
        {
            _objects.Add(added);
            Record("Added", ChangeOrigin.User, added);
        }
        foreach (var update in args.Updated)
        {
            // An object removed from the list while the user was changing it stays removed.
            var index = _objects.FindIndex(viewerObject => viewerObject.Id == update.Object.Id);
            if (index >= 0)
            {
                _objects[index] = update.Object;
                Record("Updated", ChangeOrigin.User, update.Object);
            }
        }
        foreach (var removed in args.Removed)
        {
            _objects.RemoveAll(viewerObject => viewerObject.Id == removed.Id);
            Record("Removed", ChangeOrigin.User, removed);
        }

        if (ConfirmDraw && args.Added is [var drawn, ..])
        {
            _pendingDialog = new TaskCompletionSource<bool>();
            StateHasChanged();
            var keep = await _pendingDialog.Task;
            _pendingDialog = null;
            if (!keep)
            {
                _objects.RemoveAll(viewerObject => viewerObject.Id == drawn.Id);
            }
        }
    }

    private void Record(string kind, ChangeOrigin origin, ViewerObject viewerObject)
    {
        _lastChange = $"{kind} {origin} {viewerObject.Id}";
        _lastKind = viewerObject.Kind ?? "";
    }
}
